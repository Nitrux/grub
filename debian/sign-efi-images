#!/bin/sh
set -e

if [ "$#" -ne 4 ]; then
	echo "Usage: $0 INPUT-DIRECTORY OUTPUT-DIRECTORY KEY CERT" >&2
	exit 2
fi

input_dir="$1"
output_dir="$2"
key="$3"
cert="$4"

if [ -z "$key" ] || [ -z "$cert" ]; then
	echo "SB_KEY and SB_CERT must point to the Secure Boot signing key and certificate." >&2
	exit 2
fi

if [ ! -r "$key" ]; then
	echo "Secure Boot signing key is not readable: $key" >&2
	exit 2
fi

if [ ! -r "$cert" ]; then
	echo "Secure Boot signing certificate is not readable: $cert" >&2
	exit 2
fi

if ! command -v sbsign >/dev/null 2>&1; then
	echo "sbsign is required to create grub-efi-amd64-signed." >&2
	exit 2
fi

mkdir -p -- "$output_dir"
found=0
for image in "$input_dir"/*.efi; do
	[ -f "$image" ] || continue
	found=1
	filename=${image##*/}
	sbsign --key "$key" --cert "$cert" \
		--output "$output_dir/$filename.signed" "$image"
done

if [ "$found" -eq 0 ]; then
	echo "No EFI images found in: $input_dir" >&2
	exit 1
fi
